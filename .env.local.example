# Calendly scheduling link, embedded on the left of the Contact section.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/dental-growth-lab/intro-call

# Web3Forms access key for the enquiry form ("Send to founder").
# Get one free at https://web3forms.com (enter the inbox it should deliver to).
# Until this is set the form shows its confirmation but sends nothing.
NEXT_PUBLIC_WEB3FORMS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

NEXT_PUBLIC_CONTACT_EMAIL=hello@dentalgrowthlab.co.uk
NEXT_PUBLIC_CONTACT_PHONE=020 7946 0958
